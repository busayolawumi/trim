# Neon Postgres connection string (https://neon.tech, free tier)
DATABASE_URL=

# Long random string used to sign session cookies: openssl rand -base64 32
SESSION_SECRET=

# Public base URL for short links
NEXT_PUBLIC_SHORT_BASE_URL=http://localhost:3000

# Email for password resets (https://resend.com, free tier). Leave blank locally to log emails to the console.
RESEND_API_KEY=
EMAIL_FROM="Trim <trim@your-verified-domain.com>"

# Google Safe Browsing API key, to block phishing/malware links. Leave blank locally to skip the check.
SAFE_BROWSING_API_KEY=
